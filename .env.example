# =============================================================================
# Whiteboard — Environment Template
# =============================================================================
# Two consumers, two files (both gitignored, both derive from this template):
#   - `.env`               (repo root)  → docker-compose + realtime server
#   - `apps/web/.env.local`             → Next.js web app (its native location)
# A dev-filled copy of each already exists so the app runs out of the box.
# NEVER commit real secrets (Security Guideline #20). In production, inject these
# via your platform's secret manager, not files.
# Each variable is validated at boot by the typed env schema in each app
# (apps/web/src/env.ts, apps/realtime/src/env.ts) — the app refuses to start
# if a required secret is missing or malformed.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database (packages/db) ------------------------------------------------
# Local dev matches docker-compose.yml. Production MUST use sslmode=require.
POSTGRES_USER=whiteboard
POSTGRES_PASSWORD=whiteboard_dev_password
POSTGRES_DB=whiteboard
# Container maps host 5433 -> container 5432 (native Postgres often owns 5432).
DATABASE_URL="postgresql://whiteboard:whiteboard_dev_password@localhost:5433/whiteboard?schema=public"

# --- Redis (cache / pub-sub / rate-limit backend) --------------------------
REDIS_PASSWORD=whiteboard_dev_password
REDIS_URL="redis://:whiteboard_dev_password@localhost:6379"

# --- Auth.js / NextAuth (packages/auth, apps/web) --------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# JWT signing for realtime handshake tokens (shared web <-> realtime).
# Generate with: openssl rand -base64 32
REALTIME_JWT_SECRET="replace-me-with-a-strong-random-secret"

# --- OAuth Providers (fill in during the security session) -----------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Web app ---------------------------------------------------------------
# Public URL the browser uses to reach the realtime WebSocket server.
NEXT_PUBLIC_REALTIME_URL="ws://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Realtime server (apps/realtime) ---------------------------------------
REALTIME_PORT=3001
# Comma-separated list of origins allowed to open WebSocket connections.
REALTIME_ALLOWED_ORIGINS="http://localhost:3000"
