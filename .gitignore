# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo/

# Environment & secrets (NEVER commit — see Security Guideline #20)
.env
.env.local
.env.*.local
*.pem
*.key

# Prisma
packages/db/prisma/*.db
packages/db/prisma/migrations/dev.db*
