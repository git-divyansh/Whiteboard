apps/web/src/generated/

# Local production error journal (not committed)
PROD_ERROR.md

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Editor / OS
.vscode/*
