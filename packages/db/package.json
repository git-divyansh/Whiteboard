{
  "name": "@whiteboard/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "purge-trash": "dotenv -e ../../.env -- tsx prisma/purge-trash.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "clean": "rimraf dist .turbo"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@whiteboard/config": "workspace:*",
    "dotenv-cli": "8.0.0",
    "eslint": "9.17.0",
    "prisma": "6.2.1",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
