{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Whiteboard Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    // Apps are bundled by Next, never consumed as a library — no .d.ts emit.
    // (Also avoids TS2742 on non-portable inferred types like next-auth's `auth`.)
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  }
}
